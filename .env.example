# Runi loads the nearest .env from the workspace root upward.
# Pick ONE provider below. Keep unused API keys empty.
RUNI_PROVIDER=deepseek

# DeepSeek (Anthropic-compatible API)
RUNI_DEEPSEEK_API_KEY=
RUNI_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
RUNI_DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI Responses API (or another Responses-compatible gateway)
RUNI_OPENAI_API_KEY=
RUNI_OPENAI_API_BASE=https://api.openai.com/v1
RUNI_OPENAI_MODEL=gpt-5.4

# Anthropic Messages API (or another Messages-compatible gateway)
RUNI_ANTHROPIC_API_KEY=
RUNI_ANTHROPIC_API_BASE=https://api.anthropic.com/v1
RUNI_ANTHROPIC_MODEL=claude-sonnet-4-6

# Ollama (no API key is required for the default local server)
RUNI_OLLAMA_HOST=http://127.0.0.1:11434
RUNI_OLLAMA_MODEL=qwen3.5:4b

# Optional: comma-separated extra environment variable names to redact.
RUNI_SECRET_ENV_NAMES=
